rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /* ================================
       FUNCIONES DE AYUDA
    =================================*/

    // Admin real: usuario autenticado en Firebase Auth
    function isAdmin() {
      return request.auth != null;
    }

    // Validación de media (foto o video) subida por invitados
    function isValidMedia() {
      return request.resource.data.url is string
          && request.resource.data.createdAt is string
          && request.resource.data.type in ['photo', 'video'];
    }

    /* ================================
       COLECCIÓN DE EVENTOS
    =================================*/

    match /events/{eventId} {

      // 📖 Lectura pública (invitados pueden ver el álbum)
      allow read: if true;

      // ➕➖ Crear y borrar eventos → SOLO ADMIN
      allow create, delete: if isAdmin();

      // ✏️ Actualizar evento
      // - Admin: todo
      // - Invitados: solo campos operativos (NO configuración)
      allow update: if isAdmin() ||
        request.resource.data.diff(resource.data)
          .affectedKeys()
          .hasOnly([
            'participants',
            'totalUsageBytes'
          ]);

      /* ================================
         SUBCOLECCIÓN DE FOTOS / VIDEOS
      =================================*/

      match /photos/{photoId} {

        // 👀 Lectura pública
        allow read: if true;

        // ⬆️ Invitados pueden subir fotos y videos
        allow create: if isValidMedia();

        // ❤️ Likes / 🚩 Reportes
        // - Invitados: solo likes y reports
        // - Admin: todo
        allow update: if isAdmin() ||
          request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              'likes',
              'reports'
            ]);

        // 🗑️ Borrado físico → SOLO ADMIN
        allow delete: if isAdmin();
      }
    }
  }
}
